# Keep empty until Supabase import and verification pass; set runtime only afterward.
COMPOSE_PROFILES=

# PostgreSQL（Compose 内のみ。host へ port 公開しない）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=mikage
MIKAGE_API_DB_PASSWORD=
MIKAGE_MAINTENANCE_DB_PASSWORD=

# 監視 API の Bearer トークン（ダミー例。本番値は Dokploy の service 環境変数へ設定）
MIKAGE_API_BEARER_TOKEN=

# Admin target URLs must use an exact host from this allowlist.
MIKAGE_TARGET_ALLOWED_HOSTS=example.invalid

# Management UI/API accepts only these request Host names. Use the LAN-only Dokploy service domain in production.
MIKAGE_ADMIN_ALLOWED_HOSTS=targets.lan.example

# Compose watch-scheduler calls this Render route every minute; use a separate header token from MIKAGE_API_BEARER_TOKEN.
# Compose requires an explicit per-service value; keep local disabled and enable only after Render URL/token are set in Dokploy.
WATCH_SCHEDULER_ENABLED=false
MIKAGE_RENDER_WATCH_URL=https://mikage.example.invalid/api/v1/watch
MIKAGE_WATCH_EXECUTE_TOKEN=

# Only set these for a supervised, one-off staging migration. Keep credentials out of Git.
# The importer streams the four application tables and creates no dump file.
MIKAGE_SOURCE_PGHOST=
MIKAGE_SOURCE_PGPORT=5432
MIKAGE_SOURCE_PGUSER=
MIKAGE_SOURCE_PGPASSWORD=
MIKAGE_SOURCE_WRITES_FROZEN=
# Staging-only: set to the ID returned by pg_export_snapshot() while its source transaction stays open.
MIKAGE_SOURCE_SNAPSHOT_ID=
MIKAGE_SOURCE_PGDATABASE=postgres
MIKAGE_SOURCE_PGSSLMODE=verify-full
MIKAGE_SOURCE_PGSSLROOTCERT_BASE64=
