# Import inside the existing gw-aws.bab.dad site block, after the
# CloudFront origin-verification handler and /health handler.
# This fragment deliberately excludes /admin and /v1/admin/*.
# MIKAGE_API_HOST must match the LAN-only Dokploy Domain host for the API service.

@office_mikage_watch_targets {
	method GET
	path /office/mikage/watch-targets
}
handle @office_mikage_watch_targets {
	rewrite * /v1/monitoring/targets
	reverse_proxy {$MIKAGE_API_UPSTREAM} {
		header_up Host {$MIKAGE_API_HOST}
		transport http {
				tls_server_name {$MIKAGE_API_HOST}
		}
		header_up -X-Origin-Verify
	}
}

@office_mikage_watch_reservations {
	method POST
	path /office/mikage/watch-reservations
}
handle @office_mikage_watch_reservations {
	rewrite * /v1/watch/reservations
	reverse_proxy {$MIKAGE_API_UPSTREAM} {
		header_up Host {$MIKAGE_API_HOST}
		transport http {
				tls_server_name {$MIKAGE_API_HOST}
